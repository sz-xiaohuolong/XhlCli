# Copy this file to .env. The .env file is ignored by Git.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# Optional overrides
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# XHLCLI_CONNECT_TIMEOUT_SECONDS=30
# XHLCLI_READ_TIMEOUT_SECONDS=300
# XHLCLI_REQUEST_TIMEOUT_SECONDS=600
# XHLCLI_AGENT_MAX_ITERATIONS=10
# XHLCLI_AGENT_TIMEOUT_SECONDS=600
# XHLCLI_LOG_LEVEL=WARN

# 主 ReactAgent 记忆召回；条数包含固定记忆，Token 包含包装文字
# XHLCLI_MEMORY_MAX_ENTRIES=5
# XHLCLI_MEMORY_TOKEN_BUDGET=1500
# XHLCLI_MEMORY_MIN_SCORE=0.18
