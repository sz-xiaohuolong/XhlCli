{
  "name": "xhlcli-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "XhlCLI 本地编程桌面端",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "package": "npm run build && node scripts/prepare.mjs && electron-builder --mac dir --arm64 -c.directories.output=release/bundled",
    "distribute": "npm run package && node scripts/distribute.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.xhlcli.desktop",
    "productName": "XhlCLI",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/xhlcli.jar",
        "to": "xhlcli.jar"
      },
      {
        "from": "resources/runtime",
        "to": "runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "13.0",
      "signIgnore": [
        "Contents/Resources/runtime($|/)"
      ]
    }
  }
}
